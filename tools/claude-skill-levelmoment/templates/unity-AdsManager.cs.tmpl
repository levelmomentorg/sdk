using System;
using LevelMoment;

public sealed class LevelMomentRewardedSlot
{
    private readonly string _placementId;
    private readonly Action _pauseGame;
    private readonly Action _resumeGame;
    private readonly Action _grantChosenBonus;
    private readonly Action _prepareNextSlot;

    public LevelMomentRewardedSlot(
        string placementId,
        Action pauseGame,
        Action resumeGame,
        Action grantChosenBonus,
        Action prepareNextSlot)
    {
        _placementId = placementId;
        _pauseGame = pauseGame;
        _resumeGame = resumeGame;
        _grantChosenBonus = grantChosenBonus;
        _prepareNextSlot = prepareNextSlot;
    }

    public void Show()
    {
        _pauseGame();
        var granted = false;
        var finished = false;
        Action finish = () =>
        {
            if (finished) return;
            finished = true;
            _resumeGame();
            _prepareNextSlot();
        };

        RewardedAd.Load(_placementId, new RewardedAdLoadCallbacks
        {
            OnAdLoaded = ad => ad.Show(new RewardedAdShowCallbacks
            {
                OnUserEarnedReward = amount =>
                {
                    if (!finished && amount == 1 && !granted)
                    {
                        granted = true;
                        _grantChosenBonus();
                    }
                },
                OnAdDismissed = finish,
                OnAdFailedToShow = _ => finish(),
            }),
            OnAdFailedToLoad = _ => finish(),
        });
    }

    public void EnableLearningFromPlayerAction(Action openLearningChoice)
    {
        LevelMomentAds.EnsureAccess(_placementId, result =>
        {
            if (result == EnsureSignedInResult.Ready) openLearningChoice();
        });
    }

    public void CheckLearningAccess(Action<bool> onResult, Action<string> onError)
    {
        LevelMomentAds.CheckAccess(_placementId, onResult, onError);
    }
}

