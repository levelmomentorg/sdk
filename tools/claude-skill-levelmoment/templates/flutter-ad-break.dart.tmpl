import 'package:flutter/widgets.dart';
import 'package:levelmoment_ads/levelmoment_ads.dart';

class RewardedSlotHooks {
  RewardedSlotHooks({
    required this.pauseGame,
    required this.resumeGame,
    required this.grantChosenBonus,
    required this.prepareNextSlot,
  });

  final void Function() pauseGame;
  final void Function() resumeGame;
  final void Function() grantChosenBonus;
  final void Function() prepareNextSlot;
}

Future<void> showLevelMomentRewardedSlot({
  required BuildContext context,
  required String placementId,
  required RewardedSlotHooks hooks,
}) async {
  hooks.pauseGame();
  var granted = false;
  var finished = false;
  void finish() {
    if (finished) return;
    finished = true;
    hooks.resumeGame();
    hooks.prepareNextSlot();
  }

  await LevelMomentRewardedAd.load(
    placementId: placementId,
    adLoadCallback: LevelMomentAdLoadCallback(
      onAdLoaded: (ad) {
        ad.fullScreenContentCallback = LevelMomentFullScreenContentCallback(
          onAdDismissedFullScreenContent: (_) => finish(),
          onAdFailedToShowFullScreenContent: (_, __) => finish(),
        );
        ad.show(
          context: context,
          onUserEarnedReward: (_, reward) {
            if (!finished && reward.amount == 1 && !granted) {
              granted = true;
              hooks.grantChosenBonus();
            }
          },
        );
      },
      onAdFailedToLoad: (_) => finish(),
    ),
  );
}

Future<void> enableLearningFromPlayerAction({
  required BuildContext context,
  required String placementId,
  required void Function() openLearningChoice,
}) async {
  if (await LevelMomentAds.instance.ensureAccess(
    context: context,
    placementId: placementId,
  ) == EnsureSignedInResult.ready) {
    openLearningChoice();
  }
}

Future<bool> learningIsAvailable({
  required BuildContext context,
  required String placementId,
}) {
  return LevelMomentAds.instance.checkAccess(
    context: context,
    placementId: placementId,
  );
}
