import {
  LevelMomentWebClient,
  type LevelMomentWebAd,
} from "@levelmoment/sdk-web";

type RewardedSlotHooks = {
  pauseGame(): void;
  resumeGame(): void;
  grantChosenBonus(): void;
};

export function createLevelMomentRewardedSlot(
  placementId: string,
  hooks: RewardedSlotHooks,
) {
  const client = LevelMomentWebClient.initialize({ placementId });
  let pending: LevelMomentWebAd | undefined;

  const prepare = () => {
    client.loadAd({
      onAdLoaded: (ad) => {
        pending = ad;
      },
      onAdFailedToLoad: () => {
        pending = undefined;
      },
    });
  };

  const show = () => {
    const ad = pending;
    if (!ad) return false;
    pending = undefined;
    hooks.pauseGame();

    let granted = false;
    let finished = false;
    const finish = () => {
      if (finished) return;
      finished = true;
      hooks.resumeGame();
      prepare();
    };

    ad.show({
      onUserEarnedReward: ({ amount }) => {
        if (!finished && amount === 1 && !granted) {
          granted = true;
          hooks.grantChosenBonus();
        }
      },
      onAdDismissed: finish,
      onAdFailedToShow: finish,
    });
    return true;
  };

  prepare();
  return { client, show };
}

export async function enableLearningFromPlayerAction(
  client: LevelMomentWebClient,
  openLearningChoice: () => void,
) {
  if (await client.ensureAccess() === "ready") openLearningChoice();
}

export async function learningIsAvailable(client: LevelMomentWebClient) {
  return client.checkAccess();
}
