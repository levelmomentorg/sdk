// Implements a game's own promise-based break interface with Level Moment.
// Documented at https://levelmoment.com/docs/own-break-interface; keep the
// two in step. Keep the game's interface and call sites; replace only its
// implementation. If the game already exports its own outcome or slot types,
// import those and delete the two declarations below.
import { LevelMomentWebClient, type LevelMomentWebAd } from "@levelmoment/sdk-web";

// finished: the break ended with a reward (a passed graded break).
// ended: the break ended without a reward: an interstitial break, passed or
//   failed; a failed rewarded break; or a break page that didn't load before
//   the SDK's load timeout.
// none: no break could be shown; the game carries on without one.
export type BreakOutcome = "finished" | "ended" | "none";

export interface BreakSlotSpec {
  /** Names the moment, such as "continue" or "double-coins". One slot per id. */
  id: string;
  /** How long this moment can hold the player, in seconds (5 to 300). */
  targetDurationSeconds: number;
  /**
   * What a passed break grants, in the game's own units (1 to 1,000,000).
   * Omit it, or pass 0, for a moment that grants nothing; that slot is
   * declared as an interstitial.
   */
  rewardAmount?: number;
}

interface SlotEntry {
  client: LevelMomentWebClient;
  /** Rewarded slots ask for a practice set at least; interstitials ask none. */
  format?: "practice_set";
  /** The next handle, loading in the background. Fine before access opens. */
  next: Promise<LevelMomentWebAd | undefined>;
  /** Set while a break for this slot is open, so a second tap opens nothing. */
  showing?: Promise<BreakOutcome>;
}

export function createLevelMomentBreaks(placementId: string, sandboxToken?: string) {
  const entries = new Map<string, SlotEntry>();

  const load = (entry: Pick<SlotEntry, "client" | "format">) =>
    new Promise<LevelMomentWebAd | undefined>((resolve) => {
      entry.client.loadAd(
        {
          onAdLoaded: (ad) => resolve(ad),
          onAdFailedToLoad: () => resolve(undefined),
        },
        entry.format ? { format: entry.format } : undefined,
      );
    });

  // One client per moment, so each declares its own duration and reward.
  // The first spec seen for an id fixes its slot, so pass the same spec for
  // a moment every time.
  const entryFor = (spec: BreakSlotSpec): SlotEntry => {
    let entry = entries.get(spec.id);
    if (!entry) {
      const rewarded = !!spec.rewardAmount && spec.rewardAmount > 0;
      const client = LevelMomentWebClient.initialize({
        placementId,
        slot: rewarded
          ? {
              adType: "rewarded",
              targetDurationSeconds: spec.targetDurationSeconds,
              rewardAmount: spec.rewardAmount,
            }
          : {
              adType: "interstitial",
              targetDurationSeconds: spec.targetDurationSeconds,
            },
        // Sandbox builds only. A production build passes no unsafeTesting.
        ...(sandboxToken ? { unsafeTesting: { token: sandboxToken } } : {}),
      });
      // A rewarded slot asks for a practice set at least, so it is never
      // served as a single quick question. It doesn't add questions: the
      // count still follows targetDurationSeconds.
      const format = rewarded ? ("practice_set" as const) : undefined;
      entry = { client, format, next: load({ client, format }) };
      entries.set(spec.id, entry);
    }
    return entry;
  };

  /** Call once at startup per slot so the first break opens without a wait. */
  function prepare(spec: BreakSlotSpec): void {
    entryFor(spec);
  }

  async function run(entry: SlotEntry): Promise<BreakOutcome> {
    // A player links to a Level Moment household before their first break.
    // In a sandbox build this resolves "ready" at once.
    if ((await entry.client.ensureAccess()) !== "ready") return "none";
    const ad = await entry.next;
    if (!ad) {
      entry.next = load(entry);
      return "none";
    }
    return new Promise<BreakOutcome>((resolve) => {
      let rewarded = false;
      let done = false;
      const finish = (outcome: BreakOutcome) => {
        if (done) return;
        done = true;
        entry.next = load(entry);
        resolve(outcome);
      };
      try {
        ad.show({
          // GAME HOOK: grant the reward where the promise resolves "finished".
          // This grants locally and drops rewardId. If a game server also
          // grants from the reward.earned webhook, read ({ rewardId }) here
          // and return it alongside "finished".
          onUserEarnedReward: () => {
            rewarded = true;
          },
          onAdDismissed: () => finish(rewarded ? "finished" : "ended"),
          onAdFailedToShow: () => finish(rewarded ? "finished" : "none"),
        });
      } catch {
        finish("none");
      }
    });
  }

  /** Call from the player's tap. The game awaits it before carrying on. */
  function showBreak(spec: BreakSlotSpec): Promise<BreakOutcome> {
    const entry = entryFor(spec);
    if (entry.showing) return Promise.resolve("none");
    const showing = run(entry).finally(() => {
      entry.showing = undefined;
    });
    entry.showing = showing;
    return showing;
  }

  return { prepare, showBreak };
}
