import {
  LevelMomentAd,
  checkAccess,
  ensureAccess,
} from "@levelmoment/sdk-react-native";

type RewardedSlotHooks = {
  pauseGame(): void;
  resumeGame(): void;
  grantChosenBonus(): void;
  prepareNextSlot(): void;
};

export function showLevelMomentRewardedSlot(
  placementId: string,
  hooks: RewardedSlotHooks,
) {
  hooks.pauseGame();
  const ad = LevelMomentAd.createForAdRequest(placementId, {});
  let granted = false;
  let finished = false;
  const cleanups: Array<() => void> = [];
  const finish = () => {
    if (finished) return;
    finished = true;
    cleanups.forEach((remove) => remove());
    ad.dispose();
    hooks.resumeGame();
    hooks.prepareNextSlot();
  };

  cleanups.push(ad.addAdEventListener("loaded", () => ad.show()));
  cleanups.push(
    ad.addAdEventListener("earnedReward", ({ amount }) => {
      if (!finished && amount === 1 && !granted) {
        granted = true;
        hooks.grantChosenBonus();
      }
    }),
  );
  cleanups.push(ad.addAdEventListener("closed", finish));
  cleanups.push(ad.addAdEventListener("error", finish));
  ad.load();
}

export async function enableLearningFromPlayerAction(
  placementId: string,
  openLearningChoice: () => void,
) {
  if ((await ensureAccess({ placementId })) === "ready") openLearningChoice();
}

export function learningIsAvailable(placementId: string) {
  return checkAccess({ placementId });
}
